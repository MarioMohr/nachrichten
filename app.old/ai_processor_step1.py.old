"""
This standalone script processes all pending videos in a loop. It attempts to grab the transcript using the updated methods, switches to the video title if the transcript cannot be retrieved, saves the data into a temporary JSON file, and updates the database status. It continues until no pending videos remain.
"""

import os
import json
import sqlite3
import time
from youtube_transcript_api import YouTubeTranscriptApi

DB_QUEUE_PATH = "data/video_ids.db"
TEMP_DIR = "data/temp_transcripts"

def ensure_temp_directory():
    if not os.path.exists(TEMP_DIR):
        os.makedirs(TEMP_DIR, exist_ok=True)

def fetch_single_pending_video():
    connection = sqlite3.connect(DB_QUEUE_PATH)
    cursor = connection.cursor()
    try:
        cursor.execute("SELECT video_id, title FROM video_queue WHERE ai_status = 'pending' ORDER BY discovered_at ASC LIMIT 1;")
        result = cursor.fetchone()
        return result if result else (None, None)
    except sqlite3.OperationalError:
        print("The queue database table is currently inaccessible.")
        return None, None
    finally:
        connection.close()

def update_queue_status(video_id, status):
    connection = sqlite3.connect(DB_QUEUE_PATH)
    cursor = connection.cursor()
    try:
        cursor.execute("UPDATE video_queue SET ai_status = ? WHERE video_id = ?;", (status, video_id))
        connection.commit()
        print(f"Database status for video {video_id} updated to: {status}")
    except Exception as error:
        print(f"Failed to update database status: {error}")
    finally:
        connection.close()

def extract_youtube_transcript(video_id):
    try:
        print(f"Requesting transcript from YouTube API for ID: {video_id}")
        yt_api = YouTubeTranscriptApi()
        
        try:
            transcript_data = yt_api.fetch(video_id, languages=["de", "en"])
        except TypeError:
            transcript_data = yt_api.fetch(video_id)

        if transcript_data and isinstance(transcript_data[0], dict) and "text" in transcript_data[0]:
            return " ".join([chunk["text"] for chunk in transcript_data])
        else:
            return " ".join([chunk.text for chunk in transcript_data])
            
    except Exception as error:
        print(f"Failed to fetch transcript: {error}")
        return None

def save_to_temporary_storage(video_id, text, was_fallback):
    ensure_temp_directory()
    payload = {
        "video_id": video_id,
        "text_content": text,
        "fallback_active": was_fallback
    }
    target_file = os.path.join(TEMP_DIR, f"{video_id}.json")
    with open(target_file, "w", encoding="utf-8") as file:
        json.dump(payload, file, ensure_ascii=False, indent=4)
    print(f"Successfully generated temporary file: {target_file}")

def execute_extraction_loop():
    while True:
        video_id, video_title = fetch_single_pending_video()
        
        if not video_id:
            print("No pending items discovered in the database queue. Ending loop.")
            break

        print(f"\nBeginning analysis for video ID: {video_id}")
        print(f"Video Title: {video_title}")
        
        extracted_text = extract_youtube_transcript(video_id)
        fallback_status = False
        
        if not extracted_text:
            print("No transcript was recovered. Utilizing the title as alternative text.")
            extracted_text = video_title
            fallback_status = True

        save_to_temporary_storage(video_id, extracted_text, fallback_status)
        update_queue_status(video_id, "extracted")
        
        print("Waiting a few seconds before the next request to respect rate limits.")
        time.sleep(10)

if __name__ == "__main__":
    execute_extraction_loop()

